# SnapShield AI Configuration
# Security Notice: Never commit .env or secrets to version control.

# Application Environment
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# External LLM Integration
# IMPORTANT: Raw sensitive data is NEVER sent to external LLMs.
# Only policy-cleared, redacted outputs can be transmitted.
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EXTERNAL_LLM_ENABLED=false
EXTERNAL_LLM_BASE_URL=https://api.openai.com/v1

# Local Model Architecture
MODEL_DIRECTORY=models

# File Upload & Ingestion Constraints
MAX_FILE_SIZE_MB=25.0

# Privacy & Policy Configuration
# Available Profiles: Personal, Developer
SNAPSHIELD_POLICY_PROFILE=Personal
SNAPSHIELD_DEFAULT_ACTION=REVIEW

# Hardware & NPU Acceleration Settings
# Preferences: AUTO, QNN_NPU, DIRECTML, CPU
NPU_ACCELERATION_PREFERENCE=AUTO
VERIFY_NPU_RUNTIME=true

# OCR Settings
OCR_ENGINE=tesseract_fallback
OCR_CONFIDENCE_THRESHOLD=0.70
